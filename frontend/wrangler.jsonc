{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hakeem",
  "compatibility_date": "2026-11-01",
  // The built Vite app. Unknown paths fall back to index.html so React Router
  // routes (/tenders, /tracking ...) work on a direct visit or refresh.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
