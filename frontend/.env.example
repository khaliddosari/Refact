# Copy to .env.local (git-ignored) and fill in. Restart `npm run dev` after editing.

# Required for the two map screens (الترسيات and التتبع).
# Create a browser key in Google Cloud Console, enable "Maps JavaScript API" and
# "Routes API" on its project (billing must be on), and restrict the key to your
# domains under "Website restrictions" (HTTP referrers), e.g. http://localhost:5173/*
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID with your own cloud-based style (for a green/cream basemap).
# Leave as is to use Google's default look.
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID
